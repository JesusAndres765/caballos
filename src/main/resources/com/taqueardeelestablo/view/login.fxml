<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" prefWidth="400" prefHeight="360" spacing="14"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="Controller.LoginController"
      maxWidth="Infinity" maxHeight="Infinity">

    <padding><Insets top="30" right="50" bottom="30" left="50"/></padding>

    <Label text="Ta' QueArdeElEstablo"/>
    <Label text="Login"/>

    <Label text="Usuario:"/>
    <TextField fx:id="usernameField" promptText="Nombre de usuario"/>

    <Label text="Contraseña:"/>
    <PasswordField fx:id="passwordField" promptText="Contraseña"/>

    <Label fx:id="mensajeLabel" text="" wrapText="true"/>

    <HBox spacing="10" alignment="CENTER">
        <Button text="Iniciar Sesion" onAction="#handleIniciarSesion" prefWidth="130"/>
        <Button text="Registrarse"    onAction="#handleRegistrarse"   prefWidth="130"/>
    </HBox>

</VBox>