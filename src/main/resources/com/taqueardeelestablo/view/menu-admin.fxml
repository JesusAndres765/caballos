<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="0" maxWidth="Infinity" maxHeight="Infinity"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="Controller.MenuAdminController">

    <!-- Cabecera fija fuera del TabPane -->
    <HBox spacing="10" alignment="CENTER_LEFT">
        <padding><Insets top="8" right="15" bottom="8" left="15"/></padding>
        <Label fx:id="adminLabel" text="Administrador:"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Cerrar Sesion" onAction="#handleCerrarSesion"/>
    </HBox>

    <!-- TabPane principal — ocupa todo el espacio restante -->
    <TabPane fx:id="tabPane" VBox.vgrow="ALWAYS"
             tabClosingPolicy="UNAVAILABLE">

        <!-- Tab 1: Inicio — contenido definido en FXML -->
        <Tab text="Inicio" fx:id="inicioTab">
            <content>
                <VBox spacing="0" maxHeight="Infinity">
                    <!-- Mensaje de resultado de la última operación -->
                    <Label fx:id="inicioMensajeLabel" text="" wrapText="true">
                        <padding><Insets top="6" right="15" bottom="6" left="15"/></padding>
                    </Label>
                    <!-- Lista de carreras activas -->
                    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS">
                        <content>
                            <VBox fx:id="carrerasAdminContainer" spacing="12">
                                <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>
                            </VBox>
                        </content>
                    </ScrollPane>
                </VBox>
            </content>
        </Tab>

        <!-- Tabs 2-5: contenido cargado programáticamente en el controlador -->
        <Tab text="Crear Carrera"     fx:id="tabCrearCarrera"/>
        <Tab text="Registrar Caballo" fx:id="tabRegistrarCaballo"/>
        <Tab text="Registrar Admin"   fx:id="tabRegistrarAdmin"/>
        <Tab text="Caballos"          fx:id="tabCaballos"/>

    </TabPane>
</VBox>