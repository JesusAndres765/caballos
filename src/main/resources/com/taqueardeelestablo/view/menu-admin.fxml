<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="Controller.MenuAdminController"
      stylesheets="@stylesA.css" styleClass="root-layout"
      prefWidth="1100" prefHeight="700">

    <HBox styleClass="header-bar" alignment="CENTER_LEFT">
        <VBox spacing="2">
            <Label text="🏇 Ta' QueArdeElEstablo — Panel Administrador" styleClass="header-title"/>
            <Label fx:id="adminLabel" text="Administrador: —" styleClass="header-subtitle"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Cerrar Sesión" onAction="#handleCerrarSesion" styleClass="btn-logout"/>
    </HBox>

    <TabPane fx:id="tabPane" VBox.vgrow="ALWAYS" styleClass="main-tab-pane" tabClosingPolicy="UNAVAILABLE">
        <Tab text="Inicio" fx:id="inicioTab">
            <content>
                <VBox maxHeight="Infinity">
                    <Label fx:id="inicioMensajeLabel" text="" wrapText="true" styleClass="success-label"/>
                    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" styleClass="scroll-pane-dark">
                        <VBox fx:id="carrerasAdminContainer" styleClass="container-padding" spacing="16"/>
                    </ScrollPane>
                </VBox>
            </content>
        </Tab>

        <Tab text="Crear Carrera" fx:id="tabCrearCarrera"/>
        <Tab text="Registrar Caballo" fx:id="tabRegistrarCaballo"/>
        <Tab text="Registrar Admin" fx:id="tabRegistrarAdmin"/>
        <Tab text="Caballos" fx:id="tabCaballos"/>
    </TabPane>
</VBox>
