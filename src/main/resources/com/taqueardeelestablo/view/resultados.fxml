<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox prefWidth="500" prefHeight="560" spacing="0"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="Controller.ResultadosController"
      maxWidth="Infinity" maxHeight="Infinity">

    <!-- Cabecera -->
    <HBox spacing="10" alignment="CENTER_LEFT">
        <padding><Insets top="8" right="15" bottom="8" left="15"/></padding>
        <Label fx:id="usuarioLabel" text="Usuario:"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="saldoLabel" text="Saldo: 0.00"/>
    </HBox>

    <Label text="Resultados">
        <padding><Insets left="15" bottom="6"/></padding>
    </Label>

    <!-- Posiciones finales -->
    <ScrollPane fitToWidth="true" prefHeight="170">
        <content>
            <VBox fx:id="resultadosContainer" spacing="5">
                <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
            </VBox>
        </content>
    </ScrollPane>

    <Separator/>

    <!-- Resultado de las apuestas del usuario -->
    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS">
        <content>
            <VBox fx:id="apuestasResultContainer" spacing="8">
                <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
            </VBox>
        </content>
    </ScrollPane>

    <!-- Botones -->
    <HBox spacing="20" alignment="CENTER">
        <padding><Insets top="12" bottom="12"/></padding>
        <Button text="Imprimir Tiket" onAction="#handleImprimirTiket" prefWidth="140"/>
        <Button text="Volver"         onAction="#handleVolver"         prefWidth="100"/>
    </HBox>

</VBox>