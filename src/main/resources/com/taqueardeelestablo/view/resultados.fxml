<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="Controller.ResultadosController"
      stylesheets="@styles.css" styleClass="root-layout"
      prefWidth="920" prefHeight="660">

    <HBox styleClass="header-bar, header-orange-border" alignment="CENTER_LEFT">
        <VBox spacing="2">
            <Label text="🏇 Ta' QueArdeElEstablo" styleClass="header-title"/>
            <Label fx:id="usuarioLabel" text="Usuario: —" styleClass="header-subtitle"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="saldoLabel" text="0.00" styleClass="saldo-badge"/>
    </HBox>

    <VBox alignment="CENTER" spacing="4" style="-fx-padding: 20 0 16 0; -fx-background-color: #11141A;">
        <Label text="Resultados de la Carrera" styleClass="page-title"/>
    </VBox>

    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" styleClass="scroll-pane-dark">
        <HBox spacing="0" style="-fx-padding: 0 20 20 20; -fx-background-color: #11141A;">

            <VBox spacing="10" HBox.hgrow="ALWAYS" style="-fx-padding: 0 20 0 0;">
                <Label text="CLASIFICACIÓN FINAL" styleClass="section-orange-title"/>
                <Separator styleClass="dark-separator"/>
                <VBox fx:id="resultadosContainer" spacing="6"/>
            </VBox>

            <Separator orientation="VERTICAL" styleClass="dark-separator"/>

            <VBox spacing="10" HBox.hgrow="ALWAYS" style="-fx-padding: 0 0 0 20;">
                <Label text="MIS APUESTAS" styleClass="section-orange-title"/>
                <Separator styleClass="dark-separator"/>
                <VBox fx:id="apuestasResultContainer" spacing="8"/>
            </VBox>

        </HBox>
    </ScrollPane>

    <HBox alignment="CENTER_RIGHT" spacing="10" styleClass="footer-bar">
        <Button text="IMPRIMIR TICKET" onAction="#handleImprimirTiket" styleClass="btn-back"/>
        <Button text="← VOLVER AL INICIO" onAction="#handleVolver" styleClass="button-primary" style="-fx-padding: 9 20 9 20;"/>
    </HBox>

</VBox>
