<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox prefWidth="380" prefHeight="240" spacing="16" alignment="CENTER"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="Controller.ActualizarCaballoController">

    <padding><Insets top="20" right="35" bottom="20" left="35"/></padding>

    <Label text="Actualizar Caballo"/>

    <GridPane hgap="15" vgap="12" alignment="CENTER">
        <Label text="Nombre:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <TextField fx:id="nombreField" prefWidth="200"
                   GridPane.columnIndex="1" GridPane.rowIndex="0"/>

        <Label text="Numero:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
        <TextField fx:id="numeroField" prefWidth="200"
                   GridPane.columnIndex="1" GridPane.rowIndex="1"/>
    </GridPane>

    <Label fx:id="mensajeLabel" text="" wrapText="true"/>

    <HBox spacing="20" alignment="CENTER">
        <Button fx:id="actualizarBtn" text="Actualizar"
                onAction="#handleActualizar" prefWidth="120"/>
        <Button text="Cancelar"
                onAction="#handleCancelar" prefWidth="100"/>
    </HBox>

</VBox>