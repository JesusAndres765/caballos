<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane fitToWidth="true" fitToHeight="true"
            xmlns:fx="http://javafx.com/fxml" fx:controller="Controller.CrearCarreraController" styleClass="scroll-pane-dark">

    <VBox spacing="16" maxWidth="700" style="-fx-padding: 24 32 24 32; -fx-background-color: #11141A;">

        <!-- Titulo de sección -->
        <VBox spacing="4">
            <Label text="CREAR NUEVA CARRERA" styleClass="section-orange-title"/>
            <Separator styleClass="dark-separator"/>
        </VBox>

        <VBox styleClass="admin-section" spacing="12">
            <Label text="CABALLOS A PARTICIPAR" styleClass="form-label"/>
            <HBox spacing="12" alignment="CENTER_LEFT">
                <ComboBox fx:id="numCaballosCombo" prefHeight="38" prefWidth="100" styleClass="combo-box"/>
                <Button text="⟳  Cargar caballos" onAction="#handleCargar" prefHeight="38" styleClass="btn-load"/>
            </HBox>
        </VBox>

        <VBox styleClass="admin-section" spacing="12">
            <Label text="DURACIÓN DE LA CARRERA (segundos — mín. 30, máx. 120)" styleClass="form-label"/>
            <TextField fx:id="duracionField" promptText="ej. 60" prefHeight="40" maxWidth="200" styleClass="text-field"/>
        </VBox>

        <VBox styleClass="admin-section" spacing="14">
            <Label text="TIEMPO DE ESPERA ANTES DE INICIAR" styleClass="form-label"/>

            <fx:define>
                <ToggleGroup fx:id="gateraGroup"/>
            </fx:define>

            <GridPane hgap="20" vgap="12">
                <RadioButton text="2 minutos"  toggleGroup="$gateraGroup" userData="2" styleClass="radio-button" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                <RadioButton text="5 minutos"  toggleGroup="$gateraGroup" userData="5"
                             styleClass="radio-button" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                <RadioButton text="10 minutos" toggleGroup="$gateraGroup" userData="10"
                             styleClass="radio-button" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
                <RadioButton text="15 minutos" toggleGroup="$gateraGroup" userData="15"
                             styleClass="radio-button" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                <RadioButton text="20 minutos" toggleGroup="$gateraGroup" userData="20"
                             styleClass="radio-button" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                <RadioButton text="30 minutos" toggleGroup="$gateraGroup" userData="30"
                             styleClass="radio-button" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
            </GridPane>
        </VBox>

        <VBox spacing="8">
            <Label text="CABALLOS SELECCIONADOS" styleClass="form-label"/>
            <TableView fx:id="caballosTable" prefHeight="200"
                       styleClass="table-view">
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>
        </VBox>

        <Label fx:id="mensajeLabel" text="" wrapText="true" styleClass="error-label"/>

        <Button text="CREAR CARRERA" onAction="#handleCrearCarrera" prefHeight="46" prefWidth="220" styleClass="button-primary"/>

    </VBox>
</ScrollPane>
