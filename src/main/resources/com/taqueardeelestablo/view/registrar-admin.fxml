<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane xmlns:fx="http://javafx.com/fxml" fx:controller="Controller.RegistrarAdminController" style="-fx-background-color: #11141A;">

    <VBox spacing="20" maxWidth="420" alignment="CENTER" styleClass="card">
        <padding>
            <Insets top="30" right="40" bottom="30" left="40"/>
        </padding>

        <VBox spacing="4">
            <Label text="REGISTRAR ADMINISTRADOR" styleClass="page-title"/>
            <Label text="El nuevo admin tendrá acceso completo al panel" styleClass="form-label"/>
        </VBox>

        <Separator styleClass="dark-separator"/>

        <VBox spacing="14">
            <VBox spacing="6">
                <Label text="NOMBRE DE USUARIO" styleClass="form-label"/>
                <TextField fx:id="usernameField" promptText="Nombre de usuario" prefHeight="42" styleClass="text-field"/>
            </VBox>
            <VBox spacing="6">
                <Label text="CONTRASEÑA" styleClass="form-label"/>
                <PasswordField fx:id="passwordField" promptText="Contraseña" prefHeight="42" styleClass="password-field"/>
            </VBox>
        </VBox>

        <Label fx:id="mensajeLabel" text="" wrapText="true" styleClass="error-label"/>

        <Button text="EGISTRAR ADMINISTRADOR" onAction="#handleRegistrar" maxWidth="Infinity" prefHeight="44" styleClass="button-primary"/>
    </VBox>
</StackPane>
