<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="Controller.DashboardUsuarioController"
      stylesheets="@styles.css"
      styleClass="root-layout"
      prefWidth="920" prefHeight="660">

    <!-- HEADER -->
    <HBox styleClass="header-bar" alignment="CENTER_LEFT">
        <VBox spacing="2">
            <Label text="🏇 Ta' QueArdeElEstablo" styleClass="header-title"/>
            <Label fx:id="usuarioLabel" text="Usuario: ?" styleClass="header-subtitle"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="saldoLabel" text="0.00" styleClass="saldo-badge"/>
    </HBox>

    <TabPane VBox.vgrow="ALWAYS" styleClass="main-tab-pane">

        <Tab text="🏁  Carreras Disponibles" closable="false">
            <ScrollPane fitToWidth="true" styleClass="scroll-pane-dark">
                <VBox fx:id="carrerasContainer" styleClass="container-padding" spacing="16"/>
            </ScrollPane>
        </Tab>

        <Tab text="Transacciones" closable="false">
            <VBox alignment="CENTER" spacing="20" styleClass="container-padding">

                <VBox spacing="4" alignment="CENTER">
                    <Label text="MONEDERO" styleClass="section-title"/>
                    <Label text="Administra tus fondos" styleClass="section-subtitle"/>
                </VBox>

                <VBox spacing="12" alignment="CENTER" maxWidth="300">
                    <Button text="Depositar Fondos" onAction="#handleDepositar" styleClass="btn-deposit" maxWidth="Infinity"/>
                    <Button text="Retirar Fondos" onAction="#handleRetirar" styleClass="btn-withdraw" maxWidth="Infinity"/>
                    <Button text="Historial de Apuestas" onAction="#handleHistorial" styleClass="btn-history" maxWidth="Infinity" prefHeight="45"/>
                </VBox>

                <Region VBox.vgrow="ALWAYS"/>

                <Button text="🚪  Cerrar Sesión" onAction="#handleCerrarSesion" styleClass="btn-logout"/>
            </VBox>
        </Tab>

    </TabPane>

    <!-- FOOTER -->
    <HBox styleClass="footer-bar">
        <Button text="VER MIS APUESTAS ACTIVAS" onAction="#handleVerApuestasActivas" styleClass="button-primary" prefHeight="38"/>
    </HBox>

</VBox>
