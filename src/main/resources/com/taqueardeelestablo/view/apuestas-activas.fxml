<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="Controller.ApuestasActivasController"
      stylesheets="@styles.css" styleClass="root-layout"
      prefWidth="920" prefHeight="660">

    <HBox alignment="CENTER_LEFT" styleClass="header-bar header-orange-border">
        <VBox spacing="2">
            <Label text="Ta' QueArdeElEstablo" styleClass="header-title"/>
            <Label fx:id="usuarioLabel" text="Usuario: ?" styleClass="header-subtitle"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="saldoLabel" text="0.00" styleClass="saldo-badge"/>
    </HBox>

    <VBox styleClass="title-section">
        <Label text="MIS APUESTAS ACTIVAS" styleClass="section-orange-title"/>
        <Separator styleClass="dark-separator"/>
    </VBox>

    <ScrollPane fitToWidth="true" fitToHeight="true" VBox.vgrow="ALWAYS" styleClass="scroll-pane-dark">
        <VBox fx:id="apuestasContainer" spacing="10" styleClass="container-padding-alt"/>
    </ScrollPane>

    <HBox alignment="CENTER_RIGHT" styleClass="footer-bar">
        <Button text="&lt;- VOLVER AL INICIO" onAction="#handleVolver" styleClass="btn-back"/>
    </HBox>

</VBox>
