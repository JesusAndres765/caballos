<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane xmlns:fx="http://javafx.com/fxml" fx:controller="Controller.RegistrarCaballoController" style="-fx-background-color: #11141A;">

    <VBox spacing="20" maxWidth="420" alignment="CENTER" styleClass="card">
        <padding>
            <Insets top="30" right="40" bottom="30" left="40"/>
        </padding>

        <!-- Título -->
        <VBox spacing="4">
            <Label text="🐎  REGISTRAR CABALLO" styleClass="page-title"/>
            <Label text="El número de caballo debe ser único" styleClass="form-label"/>
        </VBox>

        <Separator styleClass="dark-separator"/>

        <!-- Campos -->
        <VBox spacing="14">
            <VBox spacing="6">
                <Label text="NOMBRE" styleClass="form-label"/>
                <TextField fx:id="nombreField" promptText="Nombre del caballo" prefHeight="42" styleClass="text-field"/>
            </VBox>
            <VBox spacing="6">
                <Label text="NÚMERO IDENTIFICADOR" styleClass="form-label"/>
                <TextField fx:id="numeroField" promptText="Número único" prefHeight="42" styleClass="text-field"/>
            </VBox>
        </VBox>

        <Label fx:id="mensajeLabel" text="" wrapText="true" styleClass="error-label"/>

        <Button text="REGISTRAR CABALLO" onAction="#handleRegistrar" maxWidth="Infinity" prefHeight="44" styleClass="button-primary"/>
    </VBox>
</StackPane>
