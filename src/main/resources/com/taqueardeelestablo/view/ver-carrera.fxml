<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="Controller.VerCarreraController"
      stylesheets="@styles.css" styleClass="root-layout"
      prefWidth="920" prefHeight="660">

    <!-- HEADER -->
    <HBox styleClass="header-bar, header-orange-border" alignment="CENTER_LEFT">
        <VBox spacing="2">
            <Label text="🏇 Ta' QueArdeElEstablo" styleClass="header-title"/>
            <Label fx:id="usuarioLabel" text="Usuario: —" styleClass="header-subtitle"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="saldoLabel" text="0.00" styleClass="saldo-badge"/>
    </HBox>

    <VBox alignment="CENTER" spacing="6"
          style="-fx-padding: 18 0 14 0; -fx-background-color: #11141A;">
        <Label fx:id="tituloLabel" text="Carrera" styleClass="titulo-carrera"/>
        <Label fx:id="timerLabel"  text="—"       styleClass="timer-carrera"/>
    </VBox>

    <Separator styleClass="dark-separator"/>

    <ScrollPane fitToWidth="true" fitToHeight="true" VBox.vgrow="ALWAYS" styleClass="scroll-pane-dark">
        <StackPane style="-fx-background-color: #11141A;">
            <VBox fx:id="caballosContainer" spacing="8" StackPane.alignment="CENTER" style="-fx-padding: 14 24 14 24; -fx-background-color: #11141A;"/>
        </StackPane>
    </ScrollPane>

    <!-- FOOTER -->
    <HBox alignment="CENTER_RIGHT" spacing="10" styleClass="footer-bar">
        <Button fx:id="verResultadosBtn" text="VER RESULTADOS" onAction="#handleVerResultados" disable="true" styleClass="button-primary" style="-fx-padding: 9 20 9 20;"/>
        <Button text="← VOLVER" onAction="#handleVolver" styleClass="btn-back"/>
    </HBox>

</VBox>
